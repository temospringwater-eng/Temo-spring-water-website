# Local development only. Never commit real secrets.
APP_ENV=local
API_VERSION=v1
ALLOWED_ORIGIN=http://localhost:8787

# Required for Step 4B.
# Point this to the trusted deployed TEMO ERP backend, for example:
# https://erp.example.com
ERP_API_BASE_URL=

# OTP remains disabled until an approved provider is configured.
OTP_PROVIDER=
OTP_API_KEY=
